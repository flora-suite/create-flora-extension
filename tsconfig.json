{
  "include": ["./src/**/*"],
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "lib": ["es2020"],
    "target": "ES2022",
    "module": "CommonJS",

    "moduleResolution": "node",
    "esModuleInterop": true,
    "importHelpers": false,

    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "strict": true,
    "skipLibCheck": true
  }
}
